# ===================================================================
# ORAI AI Image & Video Studio - Configuration Template
# ===================================================================

# -------------------------------------------------------------------
# 1. Cloudflare Workers AI Pool (FLUX.1 Schnell Image Generation)
# -------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_account_id_1
CLOUDFLARE_API_TOKEN=your_api_token_1

CLOUDFLARE_ACCOUNT_ID_2=your_account_id_2
CLOUDFLARE_API_TOKEN_2=your_api_token_2

CLOUDFLARE_ACCOUNT_ID_3=your_account_id_3
CLOUDFLARE_API_TOKEN_3=your_api_token_3

CLOUDFLARE_ACCOUNT_ID_4=your_account_id_4
CLOUDFLARE_API_TOKEN_4=your_api_token_4

CLOUDFLARE_ACCOUNT_ID_5=your_account_id_5
CLOUDFLARE_API_TOKEN_5=your_api_token_5

CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell
DEFAULT_STEPS=4

# -------------------------------------------------------------------
# 2. Image Fallback Engines (Gemini & Pollinations)
# -------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=optional_second_gemini_key

# Pollinations API Key (from enter.pollinations.ai)
POLLINATIONS_API_KEY=your_pollinations_key_here

# -------------------------------------------------------------------
# 3. AI Video Generation Providers (Text-to-Video & Image-to-Video)
# Configure at least ONE of these providers to generate live MP4 videos:
# -------------------------------------------------------------------
# Hugging Face Inference Token (Get free token at huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=hf_your_token_here

# Replicate API Token (from replicate.com/account/api-tokens) - SVD & Video models
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# ModelsLab Video API Key (from modelslab.com)
MODELSLAB_API_KEY=your_modelslab_api_key_here

# -------------------------------------------------------------------
# 4. Firebase Authentication & Firestore (Project save-data-19a24)
# -------------------------------------------------------------------
FIREBASE_PROJECT_ID=save-data-19a24
FIREBASE_API_KEY=AIzaSyDG_QswQHzv8d4kpmPF2gYNimhgZhTLz1Q
FIREBASE_AUTH_DOMAIN=save-data-19a24.firebaseapp.com
FIREBASE_STORAGE_BUCKET=save-data-19a24.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=240569425778
FIREBASE_APP_ID=1:240569425778:web:fe8e24f82f29dbce9c07eb

# -------------------------------------------------------------------
# 5. Studio Server Settings & Quotas
# -------------------------------------------------------------------
PORT=5000
FLASK_DEBUG=True
DAILY_IMAGE_LIMIT=25
DAILY_VIDEO_LIMIT=10