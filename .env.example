# ===================================================================
# ORAI - Multi-Account & Multi-Provider Configuration Template
# Copy this file to .env and fill in your actual values.
# ===================================================================

# Cloudflare Account 1 (Primary)
CLOUDFLARE_ACCOUNT_ID=your_account_id_1
CLOUDFLARE_API_TOKEN=your_api_token_1

# Cloudflare Account 2 (Failover Pool - Optional)
CLOUDFLARE_ACCOUNT_ID_2=your_account_id_2
CLOUDFLARE_API_TOKEN_2=your_api_token_2

# Cloudflare Account 3 (Failover Pool - Optional)
CLOUDFLARE_ACCOUNT_ID_3=your_account_id_3
CLOUDFLARE_API_TOKEN_3=your_api_token_3

# Cloudflare Account 4 (Failover Pool - Optional)
CLOUDFLARE_ACCOUNT_ID_4=your_account_id_4
CLOUDFLARE_API_TOKEN_4=your_api_token_4

# Cloudflare Account 5 (Failover Pool - Optional)
CLOUDFLARE_ACCOUNT_ID_5=your_account_id_5
CLOUDFLARE_API_TOKEN_5=your_api_token_5

# Model identifier (defaults to FLUX.1 Schnell)
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Google Gemini API Keys (Optional backup from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here

# Server configuration
PORT=5000
FLASK_DEBUG=True
DEFAULT_STEPS=4


POLLINATIONS_API_KEY=your_pollinations_api_key_here


